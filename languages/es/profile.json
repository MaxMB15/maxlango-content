    {
      "id": "presente",
      "kind": "tense",
      "label": "Presente",
      "labelGloss": "present tense",
      "order": 0,
      "role": "base-tense",
      "appliesTo": { "kind": "verb" },
      "dependsOn": [],
      "patterns": [
        {
          "matchSuffix": "ar",
          "stemStrip": 2,
          "rule": "Remove **-ar** from the infinitive to get the stem. Add the endings for each person.",
          "subtitle": "The biggest verb group in Spanish: learn this pattern once and use it for hundreds of verbs.",
          "endings": ["-o", "-as", "-a", "-amos", "-áis", "-an"]
        },
        {
          "matchSuffix": "er",
          "stemStrip": 2,
          "rule": "Remove **-er** to get the stem. The endings are the -ar ones with **e** where -ar has **a**.",
          "subtitle": "-ER verbs such as comer and beber: the yo form still ends in -o.",
          "endings": ["-o", "-es", "-e", "-emos", "-éis", "-en"]
        },
        {
          "matchSuffix": "ir",
          "stemStrip": 2,
          "rule": "Remove **-ir** to get the stem. Only the nosotros and vosotros endings differ from -er verbs.",
          "subtitle": "-IR verbs such as vivir and escribir: -imos and -ís are the only new endings.",
          "endings": ["-o", "-es", "-e", "-imos", "-ís", "-en"]
        }
      ]
    },
