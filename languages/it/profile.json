    {
      "id": "presente",
      "kind": "tense",
      "label": "Presente",
      "labelGloss": "present tense",
      "order": 0,
      "role": "base-tense",
      "appliesTo": { "kind": "verb" },
      "dependsOn": [],
      "patterns": [
        {
          "matchSuffix": "are",
          "stemStrip": 3,
          "rule": "Remove **-are** from the infinitive to get the stem. Add the endings for each person.",
          "subtitle": "The biggest verb group in Italian: learn this pattern once, use it for thousands of verbs.",
          "endings": ["-o", "-i", "-a", "-iamo", "-ate", "-ano"]
        },
        {
          "matchSuffix": "ere",
          "stemStrip": 3,
          "rule": "Remove **-ere** from the infinitive to get the stem. Add the endings for each person.",
          "subtitle": "Second-group -ERE verbs: the same endings as -are except in lui/lei, voi and loro.",
          "endings": ["-o", "-i", "-e", "-iamo", "-ete", "-ono"]
        },
        {
          "matchSuffix": "ire",
          "stemStrip": 3,
          "rule": "Remove **-ire** from the infinitive to get the stem. Add the endings for each person.",
          "subtitle": "Third-group -IRE verbs like dormire: only the voi form differs from -ere.",
          "endings": ["-o", "-i", "-e", "-iamo", "-ite", "-ono"]
        },
        {
          "matchSuffix": "ire",
          "stemStrip": 3,
          "rule": "Remove **-ire** to get the stem, then add **-isc-** before the ending in io, tu, lui/lei and loro.",
          "subtitle": "The -isc- group (finire, capire, preferire): noi and voi stay plain.",
          "endings": ["-isco", "-isci", "-isce", "-iamo", "-ite", "-iscono"]
        }
      ]
    },
