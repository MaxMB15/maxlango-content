      "dependsOn": [],
      "patterns": [
        {
          "matchSuffix": "er",
          "stemStrip": 2,
          "rule": "Remove **-er** from the infinitive to get the stem. Add the endings for each person.",
          "subtitle": "The most common verb group in French. Learn this pattern once and use it for hundreds of verbs.",
          "endings": ["-e", "-es", "-e", "-ons", "-ez", "-ent"]
        },
        {
          "matchSuffix": "ir",
          "stemStrip": 2,
          "rule": "Remove **-ir** to get the stem, then add the infix **-iss-** for plural forms.",
          "subtitle": "Second-group -IR verbs share one pattern. The plural forms add -iss- before the ending.",
          "endings": ["-is", "-is", "-it", "-issons", "-issez", "-issent"]
        },
        {
          "matchSuffix": "re",
          "stemStrip": 2,
          "rule": "Remove **-re** from the infinitive to get the stem. The 3rd person singular takes no ending.",
          "subtitle": "Third-group -RE verbs: watch the silent endings in spoken French.",
          "endings": ["-s", "-s", "∅", "-ons", "-ez", "-ent"]
        }
